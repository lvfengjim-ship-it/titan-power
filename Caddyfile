# titan-power.cn 生产配置 —— Caddy 自动签发/续期 Let's Encrypt 证书
# 前提：DNS A 记录 titan-power.cn 与 www.titan-power.cn 已指向本服务器，80/443 已放行

{
	email admin@titan-power.cn
	# 强制使用 Let's Encrypt 正式环境（默认若落入 staging，浏览器不信任）
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

www.titan-power.cn {
	redir https://titan-power.cn{uri} permanent
}

titan-power.cn {
	encode zstd gzip

	# 缓存策略（Caddy 按匹配器精确度排序，最精确者优先）：
	# HTML/API 默认不缓存 → 发版后刷新即得新版，杜绝“需强制刷新才正常”
	header Cache-Control "no-cache"

	# 图片与视频缩略图：7 天
	@media path *.jpg *.jpeg *.png *.svg *.webp /thumbnails/*
	header @media Cache-Control "public, max-age=604800"

	# Vite 哈希产物：一年 + immutable
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:3000
}
