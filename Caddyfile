# titan-power.cn 生产配置 —— Caddy 自动签发/续期 Let's Encrypt 证书
# 前提：DNS A 记录 titan-power.cn 与 www.titan-power.cn 已指向本服务器，80/443 已放行

{
	email admin@titan-power.cn
	# 强制使用 Let's Encrypt 正式环境（默认若落入 staging，浏览器不信任）
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# 关闭 HTTP/3(QUIC)：部分运营商/路由器对 UDP 443 限速或丢弃，
	# 浏览器会先尝试 QUIC 卡住数秒再回退 TCP，表现为"刷新很慢"
	servers {
		protocols h1 h2
	}
}

www.titan-power.cn {
	redir https://titan-power.cn{uri} permanent
}

titan-power.cn {
	encode zstd gzip

	# 缓存策略：三类 matcher 路径互不相交，避免同名字段互相覆盖
	# Vite 哈希产物：一年 + immutable
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# 图片与视频缩略图：7 天
	@media path *.jpg *.jpeg *.png *.svg *.webp /thumbnails/*
	header @media Cache-Control "public, max-age=604800"

	# HTML 路由不缓存：发版后刷新即新版，杜绝旧 HTML 引用失效资源
	@html path / /index.html /about /business /ai-tool /insights /contact
	header @html Cache-Control "no-cache"

	# ===== 安全响应头（安全审计 H-2 整改）=====
	# /ops/ 运维系统为独立应用，安全头由其自行配置，此处排除
	# CSP 按本站实际依赖定制：Google Fonts 样式/字体、YouTube 嵌入、
	# React/GSAP 内联样式（unsafe-inline 仅对 style 开放，script 不允许）
	@mainSite not path /ops*
	header @mainSite {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; media-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# ===== 智能运维系统（/ops/ 前缀，剥离后转发到 titan-ops 栈）=====
	redir /ops /ops/ 308
	handle_path /ops/* {
		reverse_proxy titan-ops-app-1:3003
	}

	# 注意：必须用完整容器名。titan-ops 栈也有叫 app 的服务，
	# caddy 同时接入多个网络时短名 app 会产生 DNS 歧义（曾导致主站 502）
	reverse_proxy titan-power-app-1:3000
}

# ── 彭田新材料 ptm-zj.com：反代到共享 web 网络内的 ptm-zj-web 容器 ──
# 前提：ptm-zj.com / www.ptm-zj.com 的 DNS A 记录已指向本服务器
www.ptm-zj.com {
	reverse_proxy ptm-zj-web:80
}

ptm-zj.com {
	redir https://www.ptm-zj.com{uri} permanent
}
