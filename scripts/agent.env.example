# Mac 抓取端配置 —— 复制为 .env 并填写（与 fetch-videos.mjs 放同一目录）
YOUTUBE_API_KEY=你的YouTube_API_Key
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
# 云服务器 ingest 地址与令牌（INGEST_TOKEN 与服务器 .env 中保持一致）
INGEST_URL=https://titan-power.cn/api/videos/ingest
INGEST_TOKEN=服务器生成的随机令牌
# 本机代理地址（Clash 默认 7890，按实际改）
PROXY=http://127.0.0.1:7890
